# Map Coloring using CSP (Backtracking)

# Graph representing neighboring states
graph = {
    'A': ['B', 'C', 'D'],
    'B': ['A', 'C'],
    'C': ['A', 'B', 'D'],
    'D': ['A', 'C']
}

# Available colors
colors = ['Red', 'Green', 'Blue']

# Dictionary to store color assignment
color_assignment = {}

# Check if assigning a color is valid
def is_safe(node, color):
    for neighbor in graph[node]:
        if neighbor in color_assignment and color_assignment[neighbor] == color:
            return False
    return True

# Backtracking function
def map_coloring(nodes, index):
    if index == len(nodes):
        return True

    node = nodes[index]

    for color in colors:
        if is_safe(node, color):
            color_assignment[node] = color

            if map_coloring(nodes, index + 1):
                return True

            # Backtrack
            del color_assignment[node]

    return False

# Main
nodes = list(graph.keys())

if map_coloring(nodes, 0):
    print("Color Assignment:")
    for node in nodes:
        print(f"{node} --> {color_assignment[node]}")
else:
    print("No solution exists.")
